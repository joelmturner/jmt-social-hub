# Copy this file to .env and fill in the values you need.
# Do not commit .env (it is gitignored).

# YouTube (required for YouTube posting)
# YOUTUBE_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=

# Instagram (required for Instagram feed posting via Meta Graph API)
# META_APP_ID=
# META_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=http://localhost:5173/auth/instagram/callback

# Cloudinary (optional for tagged archive; required as Instagram image_url host / CDN fallback)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Netlify build hook (optional; triggered after successful Cloudinary upload to rebuild consumer site)
# NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/633d0a3cc0a40e28d19d19c6
